    routes: [
        // Rangierstraße out of the siding onto the line: it lays the turnout over,
        // clears Sh 1 at the Sperrsignal, and — unlike a Zugstraße — may be set even
        // though the line beyond is occupied, which is exactly what collecting a rake
        // standing there needs (Ril 408).
        (
            entry: 2,
            exit: 0,
            kind: Shunt,
            switches: [(1, Diverging)],
            sections: [0],
        ),
    ],
)
