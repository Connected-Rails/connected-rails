// A scenario is declaration: events with a trigger and actions. What a trigger cannot
// express gets a script — the hook fires an event by name, the actions stay here in RON.
//
// Run it with:
//   cargo run -p app -- --line example:beispielstrecke --scenario example:probefahrt
(
    name: "Probefahrt",
    description: "Short test run on the example line: pull away, then obey the main signal.",
    player_train: 0,
    events: [
        (
            name: "welcome",
            trigger: Time(2.0),
            actions: [Message("Test run: proceed to the main signal at km 2.0.")],
        ),
        // Fired by the script, never by itself — the condition (standing still for a while
        // after having moved) needs memory, which a trigger table does not have.
        (
            name: "stalled",
            trigger: Never,
            actions: [
                Announcement("Dispatcher: are you having trouble? Report your position."),
                Score(points: -5, reason: "Unscheduled stop"),
            ],
        ),
        (
            name: "arrived",
            trigger: TrainStopped(train: 0, edge: EdgeId(0), s: 1980.0, radius: 60.0),
            actions: [
                Score(points: 20, reason: "Stopped at the signal"),
                Finish(success: true, reason: "Test run complete"),
            ],
        ),
    ],
    script: Some("example:probefahrt"),
    // Stop scoring: without a timetable only the scenario points above count.
    timetable: Some("example:probefahrt"),
    // The line the scenario runs on — `--line` on the command line wins. A composition
    // name works here too, so a scenario can chain modules.
    line: Some("example:beispielstrecke"),
)
