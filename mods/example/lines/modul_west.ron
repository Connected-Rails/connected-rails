// A line module: an ordinary line with `boundaries` — named Buffer nodes at the open
// ends. Another module that places a boundary at the same coordinates connects to it
// automatically; `compositions/gesamtstrecke.ron` chains this one with modul_ost.
//
// Several versions of a module (other epochs, other equipment) are simply several
// module files — a composition picks one by name.
//
// 2 km straight, one Ks main signal at km 1.8 with its 2000 Hz magnet.
(
    name: "Modul West",
    geoid_offset: 46.0,
    nodes: [Buffer, Buffer],
    edges: [
        (
            from: 0,
            to: 1,
            start: Geo(point: (lat: 52.0, lon: 10.0, height: 100.0), heading_deg: 90.0),
            segments: [(len: 2000.0, k0: 0.0, dk: 0.0)],
            grade: [(0.0, 0.0)],
            speed: [(0.0, 120.0)],
        ),
    ],
    devices: [
        (kind: Signal, edge: 0, s: 1800.0, lateral_offset: 3.0, payload: "(signal:Some(0))"),
        (kind: Magnet, edge: 0, s: 1800.0, payload: "(frequency:Hz2000,signal:Some(0),activation:WhenStop)"),
    ],
    sections: [(edges: [0])],
    signals: [
        (kind: Main, system: Ks, device: 0, guarded: [0], signal_type: Some("example:ks_main")),
    ],
    routes: [],
    boundaries: [
        (name: "nach_ost", node: 1),
    ],
)
