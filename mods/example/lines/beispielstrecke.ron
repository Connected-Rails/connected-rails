// A line is declaration too: nodes, edges with geometry, gradient, cant, speed, plus
// trackside equipment. `signal_type` points at a signal type of a mod — with it the aspect
// comes from that state machine instead of the built-in logic.
//
// 4 km straight, one Ks main signal at km 2.0 with a 1000 Hz magnet 1000 m ahead of it,
// and a semaphore (Form) main signal at km 3.5 whose arms are moved by the model's
// motion bindings (signal_models/form_hp.ron).
//
// Behind km 4.0 the line has somewhere to shunt to (plan ch. 11): a turnout, 600 m of
// running road on to the eastern portal, and a 300 m stabling siding off the diverging
// leg. The three places are named under `yards:` at the bottom of the file.
(
    name: "Beispielstrecke",
    geoid_offset: 46.0,
    nodes: [
        Buffer,
        // The turnout at km 4.0: root on the line, straight on to the east portal,
        // diverging into the stabling siding.
        Switch(
            root: (0, true),
            straight: (1, false),
            diverging: (2, false),
            throw_time: 6.0,
        ),
        Buffer,
        Buffer,
    ],
    edges: [
        (
            from: 0,
            to: 1,
            start: Geo(point: (lat: 52.0, lon: 10.0, height: 100.0), heading_deg: 90.0),
            segments: [(len: 4000.0, k0: 0.0, dk: 0.0)],
            grade: [(0.0, 0.0)],
            speed: [(0.0, 120.0)],
            // Superstructure per section: welded main line, jointed track from km 3 —
            // the rolling noise gets rougher there (track_types/*.ron).
            track_type: [(0.0, "example:hauptbahn"), (3000.0, "example:altbau")],
        ),
        // The running road on to the eastern portal.
        (
            from: 1,
            to: 2,
            start: Continue(edge: 0),
            segments: [(len: 600.0, k0: 0.0, dk: 0.0)],
            grade: [(0.0, 0.0)],
            speed: [(0.0, 120.0)],
            track_type: [(0.0, "example:altbau")],
        ),
        // The stabling siding: an S out of the turnout, then straight. Shunting speed
        // applies here, so 40 km/h is generous already.
        (
            from: 1,
            to: 3,
            start: Continue(edge: 0),
            // Clothoid – arc – clothoid off the straight, about 1:9, then 160 m of road.
            segments: [
                (len: 50.0, k0: 0.0, dk: -0.000025),
                (len: 40.0, k0: -0.00125, dk: 0.0),
                (len: 50.0, k0: -0.00125, dk: 0.000025),
                (len: 160.0, k0: 0.0, dk: 0.0),
            ],
            grade: [(0.0, 0.0)],
            speed: [(0.0, 40.0)],
            track_type: [(0.0, "example:altbau")],
        ),
    ],
    devices: [
        // 1000 Hz magnet at the distant signal position, active only when the main signal
        // announces a restriction.
        (kind: Magnet, edge: 0, s: 1000.0, payload: "(frequency:Hz1000,signal:Some(0),activation:WhenRestrictive)"),
        (kind: Signal, edge: 0, s: 2000.0, lateral_offset: 3.0, payload: "(signal:Some(0))"),
        // 500 Hz magnet 250 m ahead of the signal, and 2000 Hz at the signal itself.
        (kind: Magnet, edge: 0, s: 1750.0, payload: "(frequency:Hz500,signal:Some(0),activation:WhenStop)"),
        (kind: Magnet, edge: 0, s: 2000.0, payload: "(frequency:Hz2000,signal:Some(0),activation:WhenStop)"),
        (kind: Signal, edge: 0, s: 3500.0, lateral_offset: 3.0, payload: "(signal:Some(1))"),
        // 2000 Hz magnet at the semaphore — it stands at proceed on this demo line,
        // so the magnet never fires, but a main signal without one is a wiring hole
        // the editor's rule check rightly flags.
        (kind: Magnet, edge: 0, s: 3500.0, payload: "(frequency:Hz2000,signal:Some(1),activation:WhenStop)"),
        // Sperrsignal at the mouth of the stabling siding, facing a movement that is
        // leaving it: Sh 0 holds everything, Sh 1 lets a shunt out onto the line.
        (kind: Signal, edge: 2, s: 20.0, facing: Backward, lateral_offset: -2.5, payload: "(signal:Some(2))"),
        // The platform of the stop at km 1.98 (timetable/probefahrt.ron): 210 m long,
        // ending 20 m short of the main signal, left of the line. The app puts a
        // waiting crowd on it out of the mods' characters (plan ch. 12); no platform
        // body is modelled here, so the people stand on the ground (height 0).
        (kind: Platform, edge: 0, s: 1770.0, facing: Both, lateral_offset: 5.0, payload: "(name:\"Beispielstadt Bksig\",length:210.0)"),
    ],
    // Scenery with a track reference: two masts left of the line (objects/mast.ron
    // carries the default offset and rotation the editor stamps on placement).
    objects: [
        (object: "example:mast", edge: 0, s: 500.0, lateral_offset: -3.5),
        (object: "example:mast", edge: 0, s: 1200.0, lateral_offset: -3.5),
    ],
    // Where stock lives (plan ch. 11). A portal is the edge of the modelled line: the
    // track behind it runs out to a buffer stop, and trains appear and disappear there
    // and nowhere else. `facing` is the way a standing train looks — into the line — and
    // `length` is what fits on the road.
    yards: [
        (name: "Portal West", kind: Portal, edge: 0, s: 300.0, facing: Forward, length: 300.0),
        (name: "Portal Ost", kind: Portal, edge: 1, s: 300.0, facing: Backward, length: 300.0),
        (name: "Abstellgleis 1", kind: Stabling, edge: 2, s: 120.0, facing: Backward, length: 170.0),
    ],
    sections: [(edges: [0]), (edges: [1]), (edges: [2])],
    signals: [
        (
            kind: Main,
            system: Ks,
            device: 1,
            guarded: [0],
            signal_type: Some("example:ks_main"),
        ),
        // The semaphore guards nothing on this demo line — it stands at proceed
        // and swings its arm as the run starts.
        (
            kind: Main,
            system: HV,
            device: 4,
            guarded: [],
            signal_type: Some("example:hv_form"),
        ),
        // 2: the shunting signal at the siding. It shows Sh 1 only while a shunting
        // route is set over it — `requires_route` is what says so.
        (
            kind: Shunting,
            system: Ks,
            device: 6,
            guarded: [],
            requires_route: true,
            signal_type: Some("example:sperrsignal"),
        ),
    ],
    routes: [
        // Rangierstraße out of the siding onto the line: it lays the turnout over,
        // clears Sh 1 at the Sperrsignal, and — unlike a Zugstraße — may be set even
        // though the line beyond is occupied, which is exactly what collecting a rake
        // standing there needs (Ril 408).
        (
            entry: 2,
            exit: 0,
            kind: Shunt,
            switches: [(1, Diverging)],
            sections: [0],
        ),
    ],
)
