// A vehicle is declaration: masses, running resistance, brake, traction characteristic.
// Only the behaviour — here the AFB — is a script.
(
    name: "BR 101 (AFB)",
    length: 19.1,
    // Tare mass [kg] and allowance for rotating masses.
    mass_empty: 84000.0,
    rotating_mass_factor: 0.20,
    // Running resistance R = a + b*v + c*v^2 [N], v in m/s.
    davis: (a: 2200.0, b: 60.0, c: 6.5),
    brake: (
        kind: Disc,
        position: R,
        // Control valve: KE valve of a traction unit with two cylinder pressure stages,
        // changed over by speed.
        valve: KeL2a,
        // Braked weight [t] and the force that follows from it [N].
        brake_weight: 90.0,
        max_force: 127976.8,
        max_cylinder: 3.8,
        cylinder_to_reservoir: 0.35,
        has_direct: true,
        // Spring-applied parking brake, pre-controlled cylinder, air supplement brake
        // behind the regenerative brake, equalising device in the lap position.
        parking_force: 90000.0,
        spring_parking: true,
        pilot_controlled: true,
        supplement_brake: true,
        angleicher: true,
        main_volume: 1000.0,
        compressor_delivery: 2400.0,
    ),
    traction: Some(Converter(
        max_force: 300000.0,
        max_power: 6400000.0,
        v_max: 220.0,
        brake_force: 150000.0,
        brake_power: 2600000.0,
        ramp_time: 2.5,
        // From here the pull-out torque of the induction motors limits the effort.
        v_pullout: 150.0,
        regenerative: true,
        brake_fade_kmh: 10.0,
    )),
    coupler: (
        slack: 0.08,
        draw_stiffness: 3000000.0,
        buffer_stiffness: 8000000.0,
        damping: 120000.0,
        breaking_force: 1000000.0,
    ),
    adhesive_mass_fraction: 1.0,
    // Wheel slip protection: electronic creep control.
    slip_protection: CreepControl,
    gauge: 1.435,
    v_max: 220.0,
    axles: 4,
    // Bo'Bo', 2.65 m axle base per bogie.
    axle_base_sum: 5.3,
    max_payload: 0.0,
    tilt_angle_deg: 0.0,
    hunting: 0.0,
    // Train protection on board: Sifa, PZB 90 V2.0 and LZB 80. Whether the LZB guides also
    // depends on the line (conductor cable).
    safety: De(
        pzb: Some(Pzb90V20),
        lzb: true,
        sifa: Some(TimeTime),
        train_type: O,
    ),
    // Door blocking of the hauled coaches, operated from this cab.
    doors: Tb0,
    // Behaviour script: <mod>:<file stem> below scripts/.
    script: Some("example:afb"),
    // Sound table. Each entry is a trigger (what starts it), conditions (when it may be
    // heard) and dependencies (which quantity moves volume and playback speed). An entry
    // without a trigger is a loop that is only modulated — that is the normal case for
    // driving noise. A table stated here replaces the generated default completely, so it
    // has to carry everything the vehicle is to make.
    //
    // `synth:<name>` is one of the sources the app generates at start-up. A mod's own
    // samples go in the same field: `file: "example/assets/whine.ogg"`.
    sounds: [
        // Rolling noise over speed — louder and higher, both capped at the top.
        (
            name: "rolling",
            file: "synth:rolling",
            trigger: Loop,
            volume: Some((quantity: Speed, points: [(0.0, 0.0), (60.0, 0.55)])),
            pitch: Some((quantity: Speed, points: [(0.0, 0.7), (200.0, 1.7)])),
            positional: true,
        ),
        // Converter whine: volume over the tractive effort, pitch over the driving speed —
        // the motor follows the wheel on a three-phase drive.
        (
            name: "traction",
            file: "synth:traction",
            trigger: Loop,
            volume: Some((quantity: TractiveEffort, points: [(0.0, 0.0), (250.0, 0.45)])),
            pitch: Some((quantity: Speed, points: [(0.0, 0.5), (150.0, 1.5)])),
            positional: true,
        ),
        // Air hisses whenever a pressure moves, in either direction.
        (
            name: "air",
            file: "synth:air",
            trigger: Loop,
            volume: Some((quantity: AirFlow, points: [(0.0, 0.0), (0.33, 0.5)])),
            positional: true,
        ),
        (
            name: "compressor",
            file: "synth:compressor",
            trigger: Loop,
            volume: Some((quantity: Compressor, points: [(0.0, 0.0), (1.0, 0.3)])),
            positional: true,
        ),
        (
            name: "horn",
            file: "synth:horn",
            trigger: Loop,
            volume: Some((quantity: Horn, points: [(0.0, 0.0), (1.0, 0.7)])),
            positional: true,
        ),
        // The buzzer sits in the cab: not placed in the world, so it does not fade with
        // distance when the camera goes outside.
        (
            name: "buzzer",
            file: "synth:buzzer",
            trigger: Loop,
            volume: Some((quantity: Alert, points: [(0.0, 0.0), (1.0, 0.35)])),
            positional: false,
        ),
        // Brake squeal is a *condition* on a loop, not an event: it is heard while the train
        // is slow and braking, and it stops when either stops being true.
        (
            name: "brake-squeal",
            file: "synth:squeal",
            trigger: Loop,
            conditions: [
                (quantity: Speed, min: 3.0, max: 25.0),
                (quantity: BrakeEffort, min: 10.0, max: 10000.0),
            ],
            volume: Some((quantity: Speed, points: [(3.0, 0.0), (8.0, 0.3), (25.0, 0.0)])),
            pitch: Some((quantity: Speed, points: [(3.0, 0.9), (25.0, 1.25)])),
            positional: true,
        ),
        // Rail joints: the same table, only with a trigger instead of a loop. One per 30 m
        // of distance travelled — a real joint sits where the track says, which is what a
        // trackside device will do later.
        (
            name: "rail-joint",
            file: "synth:joint",
            trigger: Every(quantity: Distance, interval: 30.0),
            conditions: [(quantity: Speed, min: 3.0, max: 10000.0)],
            volume: Some((quantity: Speed, points: [(3.0, 0.12), (120.0, 0.35)])),
            pitch: Some((quantity: Speed, points: [(3.0, 0.8), (160.0, 1.4)])),
            positional: true,
        ),
    ],
    // Model, relative to the mods directory. `_LOD0`/`_LOD1` come from the node names,
    // the pantograph from the Blender custom property `ts_function` in the glTF `extras`.
    model: Some((
        file: "example/assets/br101.gltf",
        lods: [
            (level: 0, distance: 150.0),
            (level: 1, distance: 2000.0),
        ],
        parts: [
            (node: "pant_front", function: "pantograph",
             motion: Rotate(axis: (1.0, 0.0, 0.0), degrees: 45.0)),
            (node: "pant_rear", function: "pantograph",
             motion: Rotate(axis: (1.0, 0.0, 0.0), degrees: 45.0)),
        ],
    )),
)
