// Every mast of the `pylons` catalogue, once, in a row 70 m north of the track.
//
//   cargo run -p app -- --line mastparade:parade --camera fly
//
// Scratch content for looking at the models — not part of the shipped mods.
// Ordered by voltage, 80 m apart, the first 200 m ahead of the train's front —
// so the odometer in the HUD names the one abeam: mast n is at 80 n + 120
// metres. Every one faces the track head-on (`yaw_deg: 0`), which is the view a
// drawing of a pylon is made in.
(
    name: "Mastparade",
    year: Some(2026),
    fictional: true,
    nodes: [Buffer, Buffer],
    edges: [
        (
            from: 0,
            to: 1,
            start: Geo(point: (lat: 52.0, lon: 10.0, height: 100.0), heading_deg: 90.0),
            segments: [(len: 3350.6, k0: 0.0, dk: 0.0)],
            grade: [(0.0, 0.0)],
            cant: [],
            speed: [(0.0, 120.0)],
            track_type: [(0.0, "example:hauptbahn")],
            electrification: [(0.0, "ac-15kv")],
            formation: true,
        ),
    ],
    trees: [
        //  1  km 0.200  Tonnenmast (Tragmast)
        (object: "pylons:tonnenmast_380_trag", lat: 52.0006291, lon: 10.0056868, yaw_deg: 0.0, scale: 1.0),
        //  2  km 0.280  Tonnenmast (Abspannmast)
