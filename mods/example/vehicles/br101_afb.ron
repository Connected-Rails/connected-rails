// A vehicle is declaration: masses, running resistance, brake, traction characteristic.
// Only the behaviour — here the AFB — is a script.
(
    name: "BR 101 (AFB)",
    length: 19.1,
    // Tare mass [kg] and allowance for rotating masses.
    mass_empty: 84000.0,
    rotating_mass_factor: 0.20,
    // Running resistance R = a + b*v + c*v^2 [N], v in m/s.
    davis: (a: 2200.0, b: 60.0, c: 6.5),
    brake: (
        kind: Disc,
        position: R,
        // Control valve: KE valve of a traction unit with two cylinder pressure stages,
        // changed over by speed.
        valve: KeL2a,
        // Braked weight [t] and the force that follows from it [N].
        brake_weight: 90.0,
        max_force: 127976.8,
        max_cylinder: 3.8,
        cylinder_to_reservoir: 0.35,
        has_direct: true,
        // Spring-applied parking brake, pre-controlled cylinder, air supplement brake
        // behind the regenerative brake, equalising device in the lap position.
        parking_force: 90000.0,
        spring_parking: true,
        pilot_controlled: true,
        supplement_brake: true,
        angleicher: true,
        main_volume: 1000.0,
        compressor_delivery: 2400.0,
    ),
    traction: Some(Converter(
        max_force: 300000.0,
        max_power: 6400000.0,
        v_max: 220.0,
        brake_force: 150000.0,
        brake_power: 2600000.0,
        ramp_time: 2.5,
        // From here the pull-out torque of the induction motors limits the effort.
        v_pullout: 150.0,
        regenerative: true,
        brake_fade_kmh: 10.0,
    )),
    coupler: (
        slack: 0.08,
        draw_stiffness: 3000000.0,
        buffer_stiffness: 8000000.0,
        damping: 120000.0,
        breaking_force: 1000000.0,
    ),
    adhesive_mass_fraction: 1.0,
    // Wheel slip protection: electronic creep control.
    slip_protection: CreepControl,
    gauge: 1.435,
    v_max: 220.0,
    axles: 4,
    // Bo'Bo', 2.65 m axle base per bogie.
    axle_base_sum: 5.3,
    max_payload: 0.0,
    tilt_angle_deg: 0.0,
    hunting: 0.0,
    // Train protection on board: Sifa, PZB 90 V2.0 and LZB 80. Whether the LZB guides also
    // depends on the line (conductor cable).
    safety: De(
        pzb: Some(Pzb90V20),
        lzb: true,
        sifa: Some(TimeTime),
        train_type: O,
    ),
    // Door blocking of the hauled coaches, operated from this cab.
    doors: Tb0,
    // Behaviour script: <mod>:<file stem> below scripts/.
    script: Some("example:afb"),
    // Sound table. Each entry is a trigger (what starts it), conditions (when it may be
    // heard) and dependencies (which quantity moves volume and playback speed). An entry
    // without a trigger is a loop that is only modulated — that is the normal case for
    // driving noise. A table stated here replaces the generated default completely, so it
    // has to carry everything the vehicle is to make.
    //
    // `synth:<name>` is one of the sources the app generates at start-up. A mod's own
    // samples go in the same field: `file: "example/assets/whine.ogg"`. The cab sounds —
    // the Sifa/PZB buzzer and every button and switch click — are CC0 recordings in
    // `assets/sounds/`, credited in THIRD_PARTY_LICENSES.md.
    //
    // One sound is normally several entries. A single loop stretched over a whole speed
    // range by its playback rate drags its formants along and arrives at the top as a toy
    // train, so rolling noise and traction are three **layers** each: their volume curves
    // are overlapping windows over speed, and each layer only ever plays between 0.85 and
    // 1.25 of its own pitch. What the neighbours share is a flank — the one fades out over
    // exactly the range the next fades in over, so the sum stays flat through the handover.
    // With the window occupying the volume curve, how *loud* the sound is at all goes into
    // `factors`, which are multiplied in. Swap the six `synth:` names for six recordings
    // and nothing else about this changes.
    sounds: [
        // Rolling noise, band 1 of 3: the rumble of the running gear up to shunting speed.
        (
            name: "rolling-low",
            file: "synth:rolling-low",
            trigger: Loop,
            volume: Some((quantity: Speed, points: [(0.0, 0.0), (12.0, 1.0), (35.0, 1.0), (60.0, 0.0)])),
            factors: [
                (quantity: Speed, points: [(0.0, 0.0), (60.0, 0.55)]),
                (quantity: Roughness, points: [(0.5, 0.75), (2.0, 1.4)]),
            ],
            pitch: Some((quantity: Speed, points: [(0.0, 0.85), (60.0, 1.25)])),
            positional: true,
        ),
        // Band 2: takes over where the first fades out, hands on at 95 … 130 km/h.
        (
            name: "rolling-mid",
            file: "synth:rolling-mid",
            trigger: Loop,
            volume: Some((quantity: Speed, points: [(35.0, 0.0), (60.0, 1.0), (95.0, 1.0), (130.0, 0.0)])),
            factors: [
                (quantity: Speed, points: [(0.0, 0.0), (60.0, 0.55)]),
                (quantity: Roughness, points: [(0.5, 0.75), (2.0, 1.4)]),
            ],
            pitch: Some((quantity: Speed, points: [(35.0, 0.85), (130.0, 1.25)])),
            positional: true,
        ),
        // Band 3: the hiss of the wheel on the rail at line speed.
        (
            name: "rolling-high",
            file: "synth:rolling-high",
            trigger: Loop,
            volume: Some((quantity: Speed, points: [(95.0, 0.0), (130.0, 1.0), (260.0, 1.0), (400.0, 0.0)])),
            factors: [
                (quantity: Speed, points: [(0.0, 0.0), (60.0, 0.55)]),
                (quantity: Roughness, points: [(0.5, 0.75), (2.0, 1.4)]),
            ],
            pitch: Some((quantity: Speed, points: [(95.0, 0.85), (400.0, 1.3)])),
            positional: true,
        ),
        // Converter whine, the same three bands: which one is heard follows the driving
        // speed (the motor follows the wheel on a three-phase drive), how loud it is
        // follows the tractive effort.
        (
            name: "traction-low",
            file: "synth:traction-low",
            trigger: Loop,
            volume: Some((quantity: Speed, points: [(0.0, 0.0), (5.0, 1.0), (40.0, 1.0), (70.0, 0.0)])),
            factors: [(quantity: TractiveEffort, points: [(0.0, 0.0), (250.0, 0.45)])],
            pitch: Some((quantity: Speed, points: [(0.0, 0.85), (70.0, 1.25)])),
            positional: true,
        ),
        (
            name: "traction-mid",
            file: "synth:traction-mid",
            trigger: Loop,
            volume: Some((quantity: Speed, points: [(40.0, 0.0), (70.0, 1.0), (130.0, 1.0), (180.0, 0.0)])),
            factors: [(quantity: TractiveEffort, points: [(0.0, 0.0), (250.0, 0.45)])],
            pitch: Some((quantity: Speed, points: [(40.0, 0.85), (180.0, 1.25)])),
            positional: true,
        ),
        (
            name: "traction-high",
            file: "synth:traction-high",
            trigger: Loop,
            volume: Some((quantity: Speed, points: [(130.0, 0.0), (180.0, 1.0), (300.0, 1.0), (400.0, 0.0)])),
            factors: [(quantity: TractiveEffort, points: [(0.0, 0.0), (250.0, 0.45)])],
            pitch: Some((quantity: Speed, points: [(130.0, 0.85), (400.0, 1.3)])),
            positional: true,
        ),
        // Air hisses whenever a pressure moves, in either direction.
        (
            name: "air",
            file: "synth:air",
            trigger: Loop,
            volume: Some((quantity: AirFlow, points: [(0.0, 0.0), (0.33, 0.5)])),
            positional: true,
        ),
        (
            name: "compressor",
            file: "synth:compressor",
            trigger: Loop,
            volume: Some((quantity: Compressor, points: [(0.0, 0.0), (1.0, 0.3)])),
            positional: true,
        ),
        (
            name: "horn",
            file: "synth:horn",
            trigger: Loop,
            volume: Some((quantity: Horn, points: [(0.0, 0.0), (1.0, 0.7)])),
            positional: true,
        ),
        // The Sifa/PZB warning horn sits in the cab: not placed in the world, so it does
        // not fade with distance when the camera goes outside. The recording is a real
        // cab buzzer looped seamlessly (see THIRD_PARTY_LICENSES.md).
        (
            name: "buzzer",
            file: "example/assets/sounds/buzzer.ogg",
            trigger: Loop,
            volume: Some((quantity: Alert, points: [(0.0, 0.0), (1.0, 0.5)])),
            positional: false,
        ),
        // Brake squeal is a *condition* on a loop, not an event: it is heard while the train
        // is slow and braking, and it stops when either stops being true.
        (
            name: "brake-squeal",
            file: "synth:squeal",
            trigger: Loop,
            conditions: [
                (quantity: Speed, min: 3.0, max: 25.0),
                (quantity: BrakeEffort, min: 10.0, max: 10000.0),
            ],
            volume: Some((quantity: Speed, points: [(3.0, 0.0), (8.0, 0.3), (25.0, 0.0)])),
            pitch: Some((quantity: Speed, points: [(3.0, 0.9), (25.0, 1.25)])),
            positional: true,
        ),
        // Rail joints: the same table, only with a trigger instead of a loop. One per 30 m
        // of distance travelled — a real joint sits where the track says, which is what a
        // trackside device will do later.
        (
            name: "rail-joint",
            file: "synth:joint",
            trigger: Every(quantity: Distance, interval: 30.0),
            conditions: [(quantity: Speed, min: 3.0, max: 10000.0)],
            volume: Some((quantity: Speed, points: [(3.0, 0.12), (120.0, 0.35)])),
            pitch: Some((quantity: Speed, points: [(3.0, 0.8), (160.0, 1.4)])),
            positional: true,
        ),
        // Operating clicks of the cab controls (M6): `Control(...)` is the lever's
        // normalised position, so the edge fires no matter whether mouse, keyboard
        // or a script moved it. `Every` with the detent spacing clicks a switch on
        // both edges with one entry; a single-point curve is a constant volume.
        // Not positional — the driver's own hand is always at the same distance.
        // The samples are CC0 recordings of the real kind of hardware (see
        // THIRD_PARTY_LICENSES.md): a stiff push button for the Sifa pedal, rubber
        // keys for the PZB buttons and the screen softkeys, toggles and breakers
        // for the desk switches. Recordings play at their own pitch — a pitch
        // curve would drag the whole click along.
        (
            name: "sifa-button",
            file: "example/assets/sounds/button-stiff.ogg",
            trigger: Rises(quantity: Control(Sifa), threshold: 0.5),
            volume: Some((quantity: Speed, points: [(0.0, 0.45)])),
            positional: false,
        ),
        (
            name: "pzb-acknowledge-button",
            file: "example/assets/sounds/button-soft.ogg",
            trigger: Rises(quantity: Control(PzbAcknowledge), threshold: 0.5),
            volume: Some((quantity: Speed, points: [(0.0, 0.45)])),
            positional: false,
        ),
        (
            name: "pzb-override-button",
            file: "example/assets/sounds/button-soft.ogg",
            trigger: Rises(quantity: Control(PzbOverride), threshold: 0.5),
            volume: Some((quantity: Speed, points: [(0.0, 0.45)])),
            positional: false,
        ),
        (
            name: "pzb-free-button",
            file: "example/assets/sounds/button-soft.ogg",
            trigger: Rises(quantity: Control(PzbExempt), threshold: 0.5),
            volume: Some((quantity: Speed, points: [(0.0, 0.45)])),
            positional: false,
        ),
        (
            name: "reverser-notch",
            file: "example/assets/sounds/reverser.ogg",
            trigger: Every(quantity: Control(Reverser), interval: 0.5),
            volume: Some((quantity: Speed, points: [(0.0, 0.5)])),
            positional: false,
        ),
        (
            name: "battery-switch",
            file: "example/assets/sounds/switch-breaker.ogg",
            trigger: Every(quantity: Control(Battery), interval: 1.0),
            volume: Some((quantity: Speed, points: [(0.0, 0.6)])),
            positional: false,
        ),
        (
            name: "pantograph-switch",
            file: "example/assets/sounds/switch-toggle.ogg",
            trigger: Every(quantity: Control(Pantograph), interval: 1.0),
            volume: Some((quantity: Speed, points: [(0.0, 0.5)])),
            positional: false,
        ),
        (
            name: "main-switch-switch",
            file: "example/assets/sounds/switch-main.ogg",
            trigger: Every(quantity: Control(MainSwitch), interval: 1.0),
            volume: Some((quantity: Speed, points: [(0.0, 0.55)])),
            positional: false,
        ),
        (
            name: "compressor-switch",
            file: "example/assets/sounds/switch-toggle.ogg",
            trigger: Every(quantity: Control(Compressor), interval: 1.0),
            volume: Some((quantity: Speed, points: [(0.0, 0.5)])),
            positional: false,
        ),
        // Wiper switch: four positions 1/3 apart on the normalised travel, so
        // `Every` at that spacing clicks on each detent passed.
        (
            name: "wiper-switch",
            file: "example/assets/sounds/switch-detent.ogg",
            trigger: Every(quantity: Control(Wipers), interval: 0.3333333),
            volume: Some((quantity: Speed, points: [(0.0, 0.5)])),
            positional: false,
        ),
        // Display softkeys: a short high click on the press edge only — the same
        // rubber key as the PZB buttons, pitched up a little because the MFA keys
        // are smaller and lighter.
        (
            name: "display-key",
            file: "example/assets/sounds/button-soft.ogg",
            trigger: Rises(quantity: Control(Display(0)), threshold: 0.5),
            volume: Some((quantity: Speed, points: [(0.0, 0.35)])),
            pitch: Some((quantity: Speed, points: [(0.0, 1.2)])),
            positional: false,
        ),
        (
            name: "display-key-2",
            file: "example/assets/sounds/button-soft.ogg",
            trigger: Rises(quantity: Control(Display(1)), threshold: 0.5),
            volume: Some((quantity: Speed, points: [(0.0, 0.35)])),
            pitch: Some((quantity: Speed, points: [(0.0, 1.2)])),
            positional: false,
        ),
        // EBuLa softkeys: the same click as the MFA keys.
        (
            name: "display-key-3",
            file: "example/assets/sounds/button-soft.ogg",
            trigger: Rises(quantity: Control(Display(2)), threshold: 0.5),
            volume: Some((quantity: Speed, points: [(0.0, 0.35)])),
            pitch: Some((quantity: Speed, points: [(0.0, 1.2)])),
            positional: false,
        ),
        (
            name: "display-key-4",
            file: "example/assets/sounds/button-soft.ogg",
            trigger: Rises(quantity: Control(Display(3)), threshold: 0.5),
            volume: Some((quantity: Speed, points: [(0.0, 0.35)])),
            pitch: Some((quantity: Speed, points: [(0.0, 1.2)])),
            positional: false,
        ),
    ],
    // Model, relative to the mods directory. `_LOD0`/`_LOD1` come from the node names,
    // the pantograph from the Blender custom property `ts_function` in the glTF `extras`.
    model: Some((
        file: "example/assets/br101.gltf",
        lods: [
            (level: 0, distance: 150.0),
            (level: 1, distance: 2000.0),
        ],
        parts: [
            (node: "pant_front", function: "pantograph",
             motion: Rotate(axis: (1.0, 0.0, 0.0), degrees: 45.0)),
            (node: "pant_rear", function: "pantograph",
             motion: Rotate(axis: (1.0, 0.0, 0.0), degrees: 45.0)),
            (node: "gauge_speed", function: "gauge:speed",
             motion: Rotate(axis: (0.0, 0.0, 1.0), degrees: -240.0)),
            (node: "lamp_1000hz", function: "lamp:pzb_1000hz", motion: Visibility),
            // Wiper sweep about the windscreen normal — the -Z front face is
            // raked by 0.55 m per metre of height, so its outward normal is
            // normalize((0, 0.55, -1)).
            (node: "wiper_left", function: "wiper",
             motion: Rotate(axis: (0.0, 0.481919, -0.876216), degrees: 75.0)),
            // Second needle on the speedometer dial: AFB/LZB target speed,
            // same sweep as the speed needle (both normalised by v_max).
            (node: "gauge_v_soll", function: "gauge:mfa_v_soll",
             motion: Rotate(axis: (0.0, 0.0, 1.0), degrees: -240.0)),
            // LZB target distance: a bright bar sliding up its slot, plus a
            // four-digit counter (place 0 = ones). Each digit node shows the
            // child "0"-"9" that matches the digit of the indicator value.
            (node: "gauge_distance_bar", function: "gauge:mfa_zielentfernung",
             motion: Translate(axis: (0.0, 1.0, 0.0), metres: 0.12)),
            (node: "digit_dist_0", function: "digit:mfa_zielentfernung:0", motion: Visibility),
            (node: "digit_dist_1", function: "digit:mfa_zielentfernung:1", motion: Visibility),
            (node: "digit_dist_2", function: "digit:mfa_zielentfernung:2", motion: Visibility),
            (node: "digit_dist_3", function: "digit:mfa_zielentfernung:3", motion: Visibility),
            // Instrument backlighting: the emissive face of the panel glows
            // with its dimmer (keys , and .), so the dials read after dark.
            (node: "instrument_light", function: "switch:instrument_light", motion: Emissive),
        ],
        // Interactive 3D cab (M6): the driver's eye in model space and the
        // controls the mouse can grab. Which gesture a control answers to
        // follows from its input — buttons hold, switches cycle, levers drag.
        cab: Some((
            eye: (-0.55, 2.55, -6.5),
            // The two cab fronts: the rain runs down them and the wipers clear
            // them (plan 14.1). Their UVs run across the pane in u, which is the
            // frame the wiper sweeps in.
            windscreen: ["windscreen_front", "windscreen_rear"],
            // The same sweep the wiper_left part draws: pivot at x -0.45, y 2.2
            // on the 1.84 x 1.10 m pane whose left edge is x -0.92, y 2.15.
            wiper: Some((
                pivot: (0.2554, 0.0455),
                length: 0.60,
                rest_degrees: 0.0,
                sweep_degrees: 75.0,
                pane: (1.84, 1.10),
            )),
            controls: [
                (node: "cab_throttle", input: Throttle,
                 motion: Rotate(axis: (1.0, 0.0, 0.0), degrees: 60.0)),
                (node: "cab_brake", input: BrakeValve,
                 motion: Rotate(axis: (1.0, 0.0, 0.0), degrees: 60.0)),
                (node: "cab_reverser", input: Reverser,
                 motion: Rotate(axis: (1.0, 0.0, 0.0), degrees: 40.0)),
                (node: "cab_sifa", input: Sifa,
                 motion: Translate(axis: (0.0, -1.0, 0.0), metres: 0.015)),
                (node: "cab_battery", input: Battery,
                 motion: Rotate(axis: (1.0, 0.0, 0.0), degrees: 50.0)),
                (node: "cab_pantograph", input: Pantograph,
                 motion: Rotate(axis: (1.0, 0.0, 0.0), degrees: 50.0)),
                (node: "cab_main_switch", input: MainSwitch,
                 motion: Rotate(axis: (1.0, 0.0, 0.0), degrees: 50.0)),
                (node: "cab_compressor", input: Compressor,
                 motion: Rotate(axis: (1.0, 0.0, 0.0), degrees: 50.0)),
                (node: "cab_wipers", input: Wipers,
                 motion: Rotate(axis: (1.0, 0.0, 0.0), degrees: 60.0)),
                // Softkeys of the MFA screen; the display(ctx) hook in
                // scripts/afb.lua reads them as ctx.buttons[1] and [2].
                (node: "cab_disp_1", input: Display(0),
                 motion: Translate(axis: (0.0, -1.0, 0.0), metres: 0.01)),
                (node: "cab_disp_2", input: Display(1),
                 motion: Translate(axis: (0.0, -1.0, 0.0), metres: 0.01)),
                // Softkeys of the EBuLa screen; its HTML page receives them
                // through onButton as the 1-based indices 3 and 4.
                (node: "cab_disp_3", input: Display(2),
                 motion: Translate(axis: (0.0, -1.0, 0.0), metres: 0.01)),
                (node: "cab_disp_4", input: Display(3),
                 motion: Translate(axis: (0.0, -1.0, 0.0), metres: 0.01)),
            ],
        )),
        // Screens rendered to texture, showing all three content paths: "mfa"
        // is drawn by the display(ctx) hook in scripts/afb.lua (menu pages,
        // softkeys); "brake" carries no code at all — the script returns nil
        // for it, so its widget list below renders instead; "ebula" is an
        // HTML page (layout, bindings and script in one file below mods/).
        displays: [
            (name: "mfa", node: "screen_mfa", width: 256, height: 160),
            (name: "ebula", node: "screen_ebula", width: 256, height: 192,
             html: Some("example/displays/ebula.html")),
            (
                name: "brake",
                node: "screen_brake",
                width: 160,
                height: 120,
                widgets: [
                    Label(x: 8.0, y: 8.0, size: 12.0, text: "HL"),
                    Value(x: 44.0, y: 8.0, size: 12.0, source: Quantity(BrakePipe),
                          decimals: 2, unit: "bar", color: (1.0, 0.75, 0.2, 1.0)),
                    Label(x: 8.0, y: 30.0, size: 12.0, text: "C"),
                    Value(x: 44.0, y: 30.0, size: 12.0, source: Quantity(BrakeCylinder),
                          decimals: 2, unit: "bar", color: (1.0, 0.75, 0.2, 1.0)),
                    Label(x: 8.0, y: 52.0, size: 12.0, text: "HB"),
                    Value(x: 44.0, y: 52.0, size: 12.0, source: Quantity(MainReservoir),
                          decimals: 2, unit: "bar", color: (1.0, 0.75, 0.2, 1.0)),
                    // Brake pipe against its 5-bar regime, green on dark.
                    Bar(x: 8.0, y: 96.0, w: 144.0, h: 12.0, source: Quantity(BrakePipe),
                        max: 6.0, color: (0.3, 0.9, 0.4, 1.0)),
                ],
            ),
        ],
    )),
)
